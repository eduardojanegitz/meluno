# Copie para .env e ajuste. Nunca versione o .env.

# Banco (docker compose up -d)
DATABASE_URL="postgresql://meluno:meluno_dev@localhost:5432/meluno"
# Em produção com pooler (ex.: Neon), DATABASE_URL é a URL "pooled" e
# DIRECT_DATABASE_URL a conexão direta, usada só pelas migrations. Opcional.
DIRECT_DATABASE_URL=""
# Banco exclusivo dos testes de integração
TEST_DATABASE_URL="postgresql://meluno:meluno_dev@localhost:5432/meluno_test"

# URL pública do app (usada em links de e-mail e convites)
APP_URL="http://localhost:3000"

# Segredo do Better Auth — gere com: openssl rand -base64 32
BETTER_AUTH_SECRET="troque-por-um-segredo-aleatorio-de-32-bytes-ou-mais"

# Login com Google (opcional — o botão só aparece se ambos estiverem definidos).
# Google Cloud Console → Credenciais → ID do cliente OAuth (Aplicativo da Web):
#   origem autorizada:       http://localhost:3000
#   redirecionamento:        http://localhost:3000/api/auth/callback/google
# Passo a passo em docs/adr/0007-login-google-e-instalacao.md
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Notificações push (opcional). Gere o par com: npx web-push generate-vapid-keys
# Sem as duas chaves, o app funciona sem push (a opção não aparece no Perfil).
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contato@seu-dominio.com.br"

# Segredo das rotas agendadas (/api/cron/*), ex.: resumo semanal. openssl rand -base64 32
CRON_SECRET=""

# E-mail transacional (Resend). Em desenvolvimento, sem chave, os e-mails
# são impressos no terminal. Em produção a chave é obrigatória.
RESEND_API_KEY=""
EMAIL_FROM="Meluno <nao-responda@meluno.app>"
